# Gnani speech API keys. Separate keys are supported; GNANI_API_KEY is the shared-key fallback.
GNANI_STT_API_KEY=
GNANI_TTS_API_KEY=
# Optional shared Gnani key if both products use the same credential.
GNANI_API_KEY=

# Gemini, for the browser web call (/v1/converse). Free key: aistudio.google.com -> Get API key.
# Without it the web call still works, with scripted questions. Callers' answers are sent to Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Required to protect speech API routes and Agent Builder webhook routes.
WEBHOOK_KEY=replace-with-a-long-random-secret
PORT=8000

# Where the Kaggle Home Credit CSVs live (only needed for retraining).
# Leave unset to use data/kaggle/ inside this project.
# e.g. C:/Users/<you>/Desktop/Gnani_project/home-credit-default-risk (empty means data/kaggle/)
HOME_CREDIT_DATA_DIR=

# Deployment (see deploy/DEPLOY.md). Postgres connection string, e.g. a free Neon database.
# Leave unset locally to use the SQLite file in data/.
DATABASE_URL=
# Browser origins allowed to call the API, comma-separated (the Vercel dashboard URL).
ALLOWED_ORIGINS=
# New advisor cases are POSTed here as JSON ({"text": ...}), e.g. a Slack or Teams incoming
# webhook. Only the headline, question and case id are sent. Empty = no notification (and the
# applicant is told nobody was notified).
ADVISOR_WEBHOOK_URL=
# 0.0.0.0 inside a container; unset keeps a local run on 127.0.0.1.
HOST=
