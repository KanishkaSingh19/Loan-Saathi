# Gnani speech API keys. Separate keys are supported; GNANI_API_KEY is the shared-key fallback.
GNANI_STT_API_KEY=
GNANI_TTS_API_KEY=
# Optional shared Gnani key if both products use the same credential.
GNANI_API_KEY=

# Required to protect speech API routes and Agent Builder webhook routes.
WEBHOOK_KEY=replace-with-a-long-random-secret
PORT=8000

# Where the Kaggle Home Credit CSVs live (only needed for retraining).
# Leave unset to use data/kaggle/ inside this project.
HOME_CREDIT_DATA_DIR=
